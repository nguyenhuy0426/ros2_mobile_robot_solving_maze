<?xml version="1.0" ?>
<!--
  one_robot.sdf  —  GA Maze Training Version  (FIXED: collision + friction khôi phục)
  ═══════════════════════════════════════════════════════════════════════════════════
  VẤN ĐỀ CŨ:
    - Đã xóa <collision> trên chassis & bánh để N robot không va chạm nhau.
    - Hậu quả: mặt đất KHÔNG thể đỡ robot → robot nổi / không chạy trên sàn.

  GIẢI PHÁP:
    - Kiến trúc nay là SEQUENTIAL (1 robot duy nhất) → không cần lo inter-collision.
    - Khôi phục <collision> cho chassis (box) và 4 bánh (cylinder).
    - Thêm surface friction để bánh tiếp xúc đất thực sự.
    - Tường mê cung vẫn có collision riêng → lidar vẫn thấy tường.

  KINEMATICS (VelocityControl):
    Python tính mecanum rồi publish Twist vào /model/robot_ROBOT_ID/cmd_vel.
    Gazebo VelocityControl đặt vận tốc body trực tiếp; trọng lực + collision
    giúp robot bám đất thay vì bay lơ lửng.

  SPAWN HEIGHT:
    START_Z = 0.024 m  (= WHEEL_R = bán kính bánh)
    → trục bánh ở z = 0.024, đáy bánh chạm z = 0.000 (mặt đất).
    → chassis center ở z = 0.024 + 0.040 = 0.064 m.

  GIAO TIẾP VỚI GA (không đổi):
    INPUT  : /scanROBOT_ID, /model/robot_ROBOT_ID/pose
    OUTPUT : /model/robot_ROBOT_ID/cmd_vel  (Twist)
-->
<sdf version="1.10">
  <model name='robot_ROBOT_ID' xmlns:gz="http://gazebosim.org/schema">

    <pose>0 2 0.024 0 0 1.5708</pose>
    <self_collide>false</self_collide>

    <!-- ===== Lidar frame ===== -->
    <frame name="lidar_link" attached_to="chassis">
      <pose>0.08 0 0.06 0 0 0</pose>
    </frame>

    <!-- ═══════════════════════════════════════════════════════════
         CHASSIS
         Pose trong model frame: center ở z=0.040
         Box 0.26 × 0.155 × 0.08  → đáy chassis ở z=0.000 từ model origin
         → khi spawn tại z=0.024: đáy chassis ở world z=0.024  (trên mặt đất)
    ═══════════════════════════════════════════════════════════════ -->
    <link name='chassis'>
      <pose>0 0 0.04 0 0 0</pose>
      <gravity>true</gravity>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.003278125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.009380</iyy>   <iyz>0</iyz>
          <izz>0.012153125</izz>
        </inertia>
      </inertial>

      <!-- COLLISION chassis — đã khôi phục -->
      <collision name="collision">
        <geometry>
          <box><size>0.26 0.155 0.08</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name='visual'>
        <geometry>
          <box><size>0.26 0.155 0.08</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 1.0 1</ambient>
          <diffuse>0.5 0.5 1.0 1</diffuse>
          <specular>0.0 0.0 1.0 1</specular>
        </material>
      </visual>

      <visual name='name_label'>
        <pose>0 0.08 0.005 1.5707 0 1.5707</pose>
        <geometry>
          <text>
            <string>BOT_ROBOT_ID</string>
            <font_name>Liberation Sans</font_name>
            <height>0.015</height>
            <color>0 1 0 1</color>
            <horizontal_alignment>center</horizontal_alignment>
            <vertical_alignment>center</vertical_alignment>
          </text>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse>
          <specular>0 0 0 1</specular><emissive>0 1 0 1</emissive>
        </material>
      </visual>

      <!-- ===== 3D block letters HUY ===== -->
      <visual name="txt_H_left">
        <pose>0.036193 0.08029 0.007033 0 0 0</pose>
        <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_H_right">
        <pose>0.054290 0.08029 0.007033 0 0 0</pose>
        <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_H_mid">
        <pose>0.045242 0.08029 0.007033 0 0 0</pose>
        <geometry><box><size>0.023267 0.0031 0.005627</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_U_left">
        <pose>-0.009048 0.08029 0.007033 0 0 0</pose>
        <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_U_right">
        <pose>0.009048 0.08029 0.007033 0 0 0</pose>
        <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_U_bottom">
        <pose>0.00 0.08029 -0.004220 0 0 0</pose>
        <geometry><box><size>0.023267 0.0031 0.005627</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_Y_left">
        <pose>-0.054290 0.08029 0.012660 0 -0.7 0</pose>
        <geometry><box><size>0.005170 0.0031 0.019693</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_Y_right">
        <pose>-0.036193 0.08029 0.012660 0 0.7 0</pose>
        <geometry><box><size>0.005170 0.0031 0.019693</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="txt_Y_tail">
        <pose>-0.045242 0.08029 0.001407 0 0 0</pose>
        <geometry><box><size>0.005170 0.0031 0.016880</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>

      <!-- ===== LIDAR visual ===== -->
      <visual name="lidar_visual">
        <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.025</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse>
          <specular>0 0 0 1</specular><emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- ===== LIDAR SENSOR =====
           36 rays × 10°, range 0.05–12m, update 10 Hz.
           Ray-cast vào collision của TƯỜNG maze (chassis không cần collision riêng cho lidar).
      -->
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
        <topic>/scanROBOT_ID</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>36</samples>
              <resolution>1</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>0.013</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         WHEELS — gravity=true + COLLISION ĐÃ KHÔI PHỤC
         Mỗi bánh:
           Pose trong model frame:  z = 0.0  (trùng model origin = z_spawn=0.024 world)
           Rotation: -1.5708 quanh X → cylinder axis trở thành Y-axis
           → cylinder mở rộng ±radius theo Z → đáy bánh ở world z = z_spawn - radius
                                                                     = 0.024 - 0.024 = 0.0
           → bánh chạm đúng mặt đất (z=0).

         Friction mecanum (simplified):
           mu  = 0.8 (dọc — hướng lăn)
           mu2 = 0.3 (ngang — cho phép trượt lateral của mecanum)
    ═══════════════════════════════════════════════════════════════ -->

    <link name='front_left_wheel'>
      <pose>0.08 0.09 0.0 -1.5707 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
        </inertia>
      </inertial>
      <!-- COLLISION bánh — đã khôi phục -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.3</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
            <scale>0.00048 0.00048 0.00048</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <link name='rear_left_wheel'>
      <pose>-0.08 0.09 0.0 -1.5707 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
        </inertia>
      </inertial>
      <!-- COLLISION bánh — đã khôi phục -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.3</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
            <scale>0.00048 0.00048 0.00048</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <link name='front_right_wheel'>
      <pose>0.08 -0.09 0.0 -1.5707 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
        </inertia>
      </inertial>
      <!-- COLLISION bánh — đã khôi phục -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.3</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
            <scale>0.00048 0.00048 0.00048</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <link name='rear_right_wheel'>
      <pose>-0.08 -0.09 0.0 -1.5707 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
        </inertia>
      </inertial>
      <!-- COLLISION bánh — đã khôi phục -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.3</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='visual'>
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
            <scale>0.00048 0.00048 0.00048</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- ═══════════════════════════════════════════════════════════
         JOINTS — không đổi
    ═══════════════════════════════════════════════════════════════ -->
    <joint name='front_left_wheel_joint' type='revolute'>
      <parent>chassis</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>
    <joint name='front_right_wheel_joint' type='revolute'>
      <parent>chassis</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>
    <joint name='rear_left_wheel_joint' type='revolute'>
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>
    <joint name='rear_right_wheel_joint' type='revolute'>
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>

    <!-- ═══════════════════════════════════════════════════════════
         PLUGIN 1 — JointController × 4
    ═══════════════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>front_left_wheel_joint</joint_name>
      <topic>/wheel_fl_ROBOT_ID</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>front_right_wheel_joint</joint_name>
      <topic>/wheel_fr_ROBOT_ID</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
      <topic>/wheel_rl_ROBOT_ID</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/wheel_rr_ROBOT_ID</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>

    <!-- ═══════════════════════════════════════════════════════════
         PLUGIN 2 — VelocityControl
         Di chuyển model body bằng Twist.
         Với collision+gravity đã được khôi phục, plugin này hoạt động đúng:
           - Gazebo tích hợp lực trọng trường → bánh tiếp xúc đất
           - VelocityControl đặt vx/vy/wz → robot di chuyển trên mặt đất
           - KHÔNG còn hiện tượng nổi lơ lửng.
    ═══════════════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/robot_ROBOT_ID/cmd_vel</topic>
    </plugin>

    <!-- ═══════════════════════════════════════════════════════════
         PLUGIN 3 — PosePublisher
    ═══════════════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <update_frequency>10</update_frequency>
    </plugin>

  </model>
</sdf>