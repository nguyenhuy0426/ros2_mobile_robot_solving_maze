<?xml version="1.0" ?>
<sdf version="1.10">
    <model name='robot_ROBOT_ID' xmlns:gz="http://gazebosim.org/schema">
      <!-- Pose lấy từ mecanum_huynn.sdf (world pose của vehicle_blue) -->
      <pose>0 2 0.024 0 0 1.5708</pose>

      <!-- ===== Lidar frame (từ mecanum_huynn.sdf) ===== -->
      <frame name="lidar_link" attached_to="chassis">
        <pose>0.08 0 0.06 0 0 0</pose>
      </frame>

      <!-- ===== CHASSIS ===== -->
      <!-- Thông số chassis lấy từ mecanum_huynn.sdf -->
      <link name='chassis'>
        <pose>0 0 0.04 0 0 0</pose>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.003278125</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.009380</iyy>
            <iyz>0</iyz>
            <izz>0.012153125</izz>
          </inertia>
        </inertial>

        <!-- Thân xe: kích thước 0.26 x 0.155 x 0.08 (từ mecanum_huynn.sdf) -->
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.26 0.155 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>

        <!-- Nhãn tên (giữ lại từ one_robot.sdf, scale lại cho phù hợp) -->
        <visual name='name_label'>
          <pose>0 0.08 0.005 1.5707 0 1.5707</pose>
          <geometry>
            <text>
              <string>NEW ROBOT</string>
              <font_name>Liberation Sans</font_name>
              <height>0.015</height>
              <color>0 1 0 1</color>
              <horizontal_alignment>center</horizontal_alignment>
              <vertical_alignment>center</vertical_alignment>
            </text>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 1 0 1</emissive>
          </material>
        </visual>

        <!-- ===== 3D block letters: HUY (từ mecanum_huynn.sdf) ===== -->
        <!-- Letter H (LEFT) -->
        <visual name="txt_H_left">
          <pose>0.036193 0.08029 0.007033 0 0 0</pose>
          <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="txt_H_right">
          <pose>0.054290 0.08029 0.007033 0 0 0</pose>
          <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="txt_H_mid">
          <pose>0.045242 0.08029 0.007033 0 0 0</pose>
          <geometry><box><size>0.023267 0.0031 0.005627</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>

        <!-- Letter U (CENTER) -->
        <visual name="txt_U_left">
          <pose>-0.009048 0.08029 0.007033 0 0 0</pose>
          <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="txt_U_right">
          <pose>0.009048 0.08029 0.007033 0 0 0</pose>
          <geometry><box><size>0.005170 0.0031 0.028133</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="txt_U_bottom">
          <pose>0.00 0.08029 -0.004220 0 0 0</pose>
          <geometry><box><size>0.023267 0.0031 0.005627</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>

        <!-- Letter Y (RIGHT) -->
        <visual name="txt_Y_left">
          <pose>-0.054290 0.08029 0.012660 0 -0.7 0</pose>
          <geometry><box><size>0.005170 0.0031 0.019693</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="txt_Y_right">
          <pose>-0.036193 0.08029 0.012660 0 0.7 0</pose>
          <geometry><box><size>0.005170 0.0031 0.019693</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <visual name="txt_Y_tail">
          <pose>-0.045242 0.08029 0.001407 0 0 0</pose>
          <geometry><box><size>0.005170 0.0031 0.016880</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>

        <!-- Collision chassis -->
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.26 0.155 0.08</size>
            </box>
          </geometry>
        </collision>

        <!-- ===== LIDAR visual (từ mecanum_huynn.sdf) ===== -->
        <visual name="lidar_visual">
          <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>

        <!-- ===== LIDAR collision (từ mecanum_huynn.sdf) ===== -->
        <collision name="lidar_collision">
          <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- ===== LIDAR sensor (từ mecanum_huynn.sdf) ===== -->
        <sensor name="gpu_lidar" type="gpu_lidar">
          <pose relative_to="lidar_link">0 0 0.0 0 0 0</pose>
          <topic>/scanROBOT_ID</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>500</samples>
                <resolution>1</resolution>
                <min_angle>0.000000</min_angle>
                <max_angle>6.280000</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>0.013</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.05</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- ===== WHEELS (thông số từ mecanum_huynn.sdf) ===== -->

      <!-- Front Left Wheel -->
      <link name='front_left_wheel'>
        <pose>0.08 0.09 0.0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
              <scale>0.00048 0.00048 0.00048</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.024</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Rear Left Wheel -->
      <link name='rear_left_wheel'>
        <pose>-0.08 0.09 0.0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
              <scale>0.00048 0.00048 0.00048</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.024</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Front Right Wheel -->
      <link name='front_right_wheel'>
        <pose>0.08 -0.09 0.0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
              <scale>0.00048 0.00048 0.00048</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.024</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Rear Right Wheel -->
      <link name='rear_right_wheel'>
        <pose>-0.08 -0.09 0.0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.025</mass>
          <inertia>
            <ixx>0.0000072</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000072</iyy><iyz>0</iyz><izz>0.0000144</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
              <scale>0.00048 0.00048 0.00048</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.024</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- ===== JOINTS ===== -->
      <joint name='front_left_wheel_joint' type='revolute'>
        <parent>chassis</parent><child>front_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name='front_right_wheel_joint' type='revolute'>
        <parent>chassis</parent><child>front_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name='rear_left_wheel_joint' type='revolute'>
        <parent>chassis</parent><child>rear_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name='rear_right_wheel_joint' type='revolute'>
        <parent>chassis</parent><child>rear_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <!-- ===== MecanumDrive plugin (thông số từ mecanum_huynn.sdf) ===== -->
      <plugin
        filename="gz-sim-mecanum-drive-system"
        name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>0.18</wheel_separation>
        <wheelbase>0.16</wheelbase>
        <wheel_radius>0.024</wheel_radius>
        <min_acceleration>-5</min_acceleration>
        <max_acceleration>5</max_acceleration>
      </plugin>

    </model>
</sdf>
